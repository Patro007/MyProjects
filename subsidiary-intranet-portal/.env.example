# Environment Configuration for Subsidiary Intranet Portal
# Copy this file to .env and update with your values

# ============================================
# GENERAL SETTINGS
# ============================================
DEBUG=False
ENVIRONMENT=production
TIMEZONE=Asia/Kolkata

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_ENGINE=postgresql
DB_NAME=intranet_db
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_HOST=postgres
DB_PORT=5432
DB_BACKUP_RETENTION_DAYS=30

# Keycloak Database
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password

# ============================================
# DJANGO SETTINGS
# ============================================
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,intranet.local
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@company.com
DJANGO_SUPERUSER_PASSWORD=change_me_in_production

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production
KEYCLOAK_REALM=subsidiary-portal
KEYCLOAK_CLIENT_ID=intranet-api
KEYCLOAK_CLIENT_SECRET=change_me_in_production
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# OIDC Settings
OIDC_RP_CLIENT_ID=intranet-frontend
OIDC_RP_CLIENT_SECRET=change_me_in_production
OIDC_OP_AUTHORIZATION_ENDPOINT=${KEYCLOAK_PUBLIC_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/userinfo

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================
# CELERY CONFIGURATION (Task Queue)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Asia/Kolkata

# ============================================
# MINIO FILE STORAGE
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SECURE=False
MINIO_REGION=us-east-1
MINIO_BUCKET_PREFIX=intranet-

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@company.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@company.com

# ============================================
# FRONTEND SETTINGS
# ============================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=subsidiary-portal
REACT_APP_KEYCLOAK_CLIENT_ID=intranet-frontend

# ============================================
# BACKEND API SETTINGS
# ============================================
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://intranet.local
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost,http://intranet.local

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=8001

# ============================================
# NGINX SETTINGS
# ============================================
NGINX_UPSTREAM_BACKEND=backend:8000
NGINX_UPSTREAM_FRONTEND=frontend:3000
NGINX_UPSTREAM_KEYCLOAK=keycloak:8080
NGINX_UPSTREAM_MINIO=minio:9000

# ============================================
# GRAFANA SETTINGS
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production
GRAFANA_ADMIN_EMAIL=admin@company.com

# ============================================
# SSL/TLS SETTINGS (Optional for production)
# ============================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_ENABLED=False

# ============================================
# BACKUP & MAINTENANCE
# ============================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
MAINTENANCE_WINDOW=02:00-03:00
